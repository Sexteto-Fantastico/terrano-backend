{
  "name": "terrano-backend",
  "version": "1.0.0",
  "description": "Backend para o sistema de gerenciamento de almoxarifado Terrano",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "node scripts/generate-migration.js",
    "migration:run": "npm run typeorm migration:run -- -d src/infra/config/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/infra/config/data-source.ts",
    "schema:sync": "npm run typeorm schema:sync -- -d src/infra/config/data-source.ts",
    "migration:manager": "tsx src/infra/config/migration-manager.ts",
    "db:create": "tsx src/infra/config/ensure-database.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.13.1"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@types/multer": "^2.1.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.18.0",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "ts-morph": "^28.0.0",
    "typeorm": "^0.3.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^6.4.8",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^11.0.2",
    "tar": "^7.5.11"
  }
}
