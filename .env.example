# frontend configuration (exact origin, used by CORS, the CSRF origin check and reset links)
FRONTEND_URL=http://localhost:5173

# server configuration
PORT=3000
# Number of reverse proxies in front of the API (needed for per-IP rate limiting)
TRUST_PROXY=

# jwt configuration
# Must be random and have at least 32 characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Lifetime of the access token (the refresh token lives 7 days in an httpOnly cookie)
JWT_EXPIRES_IN=15m
# strict (web and API on the same site), lax or none (none requires HTTPS)
COOKIE_SAMESITE=strict

# initial administrator (required in production; the password must be changed at first login)
ADMIN_EMAIL=admin@terrano.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# demo data (never enabled by default in production)
SEED_DEMO_DATA=false
ENABLE_SWAGGER=false

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@terrano.com
